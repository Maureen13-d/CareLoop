@@ -0,0 +1,171 @@
+"""USSD: answer what the person raised, never leave a dead end, keep the phone discreet."""
+
+import pytest
+from sqlalchemy import select
+
+from app.core.config import settings
+from app.modules.assistant.lexicon import load_templates
+from app.modules.assistant.retrieve import load_passages, search_passages
+from app.modules.audit.models import AuditLog
+from app.modules.channels import service
+from app.modules.channels.models import SmsOptOut
+
+FORBIDDEN = ("cancer", "result", "diagnosis", "positive", "hiv", "screening")
+PHONE = "+254700000777"
+
+
+def dial(client, session, text="", phone=PHONE):
+    resp = client.post(
+        "/api/v1/channels/ussd", json={"session_id": session, "phone_ref": phone, "text": text}
+    )
+    assert resp.status_code == 200, resp.text
+    return resp.json()
+
+
+def open_tasks(client, auth):
+    return client.get("/api/v1/navigator/tasks", headers=auth["nav"]).json()
+
+
+def test_worry_answer_offers_next_steps_and_drops_sms_wording(client, auth):
+    dial(client, "a")
+    assert "2 Cost" in dial(client, "a", "3")["text"]
+    answer = dial(client, "a", "2")
+    assert "navigator" in answer["text"].lower()
+    assert "1 Call me" in answer["text"] and "0 Menu" in answer["text"]
+    assert "reply help" not in answer["text"].lower()
+    assert answer["end_session"] is False
+    task = next(t for t in open_tasks(client, auth) if t["task_type"] == "navigator_followup")
+    assert task["contact_ref"] == PHONE
+
+
+def test_call_me_after_an_answer_ends_the_session_and_keeps_the_number(client, auth):
+    dial(client, "b", "3")
+    dial(client, "b", "2")
+    done = dial(client, "b", "1")
+    assert done["end_session"] is True
+    assert "navigator" in done["text"].lower()
+    assert "reply stop" not in done["text"].lower()
+    callbacks = [t for t in open_tasks(client, auth) if t["task_type"] == "navigator_callback"]
+    assert callbacks and callbacks[0]["contact_ref"] == PHONE
+
+
+def test_menu_navigation_after_an_answer(client):
+    dial(client, "c", "3")
+    dial(client, "c", "1")
+    assert dial(client, "c", "2")["text"].startswith("Pick what worries you most")
+    dial(client, "c", "1")
+    assert "1 Next step" in dial(client, "c", "0")["text"]
+    dial(client, "c", "3")
+    dial(client, "c", "1")
+    assert dial(client, "c", "9")["text"].startswith("Choose 1, 2 or 0")
+
+
+def test_crisis_ends_the_session_and_opens_an_urgent_task(client, auth):
+    dial(client, "d", "2")
+    ended = dial(client, "d", "i want to die")
+    assert ended["end_session"] is True
+    task = next(t for t in open_tasks(client, auth) if t["task_type"] == "counsellor_urgent")
+    assert task["priority"] == "urgent"
+    assert task["contact_ref"] == PHONE
+    assert "die" not in task["summary"].lower()
+
+
+def test_typed_question_is_answered_from_an_approved_passage(client, db_session):
+    passage = search_passages("what should i bring")
+    assert passage is not None
+    dial(client, "e", "2")
+    answer = dial(client, "e", "what should i bring")
+    assert passage["text"] in answer["text"]
+    assert "1 Call me" in answer["text"]
+    assert answer["end_session"] is False
+    entry = db_session.scalars(
