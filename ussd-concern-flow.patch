+def _compose(body: str, limit: int = USSD_LIMIT, *, sms_template: bool = True) -> str:
+    """An answer followed by next steps. The options are never cut; a long answer is.
+
+    `sms_template` removes the "Reply HELP ..." sentences that templates carry for SMS.
+    Approved passages are written for this channel too, so they are left as written."""
+    body = _plain(body) if sms_template else body.strip()
+    for options in (AFTER_FULL, AFTER_SHORT):
+        screen = f"{body}\n{options}"
+        if len(screen) <= limit:
+            return screen
+    room = limit - len(AFTER_SHORT) - 1
+    return body[: room - 1].rstrip() + ".\n" + AFTER_SHORT
+
