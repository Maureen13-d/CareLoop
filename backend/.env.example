
# Seeds one scripted escalated case (case-demo) for demos
CARELOOP_DEMO_SCENARIO=false

# Telegram. Placeholders only. Never put a real token in git.
# The first four names are the ones the bot documents.
# The CARELOOP_ names are accepted so an older deploy keeps working.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
TELEGRAM_BOT_USERNAME=replace-me
PUBLIC_BASE_URL=http://localhost:8000
CARELOOP_TELEGRAM_BOT_TOKEN=replace-me
CARELOOP_TELEGRAM_WEBHOOK_SECRET=replace-me
CARELOOP_EXPOSE_SIMULATED_CODES=true
