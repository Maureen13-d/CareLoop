
# Seeds one scripted escalated case (case-demo) for demos
CARELOOP_DEMO_SCENARIO=false

# Telegram. Placeholder only. The simulator works without these.
CARELOOP_TELEGRAM_BOT_TOKEN=replace-me
CARELOOP_TELEGRAM_WEBHOOK_SECRET=replace-me
CARELOOP_EXPOSE_SIMULATED_CODES=true

# Optional. Rewords an approved Telegram line. Empty means the approved line is sent.
# OpenAI-compatible chat completions. An OpenRouter key (sk-or-) uses
# https://openrouter.ai/api/v1 and nvidia/nemotron-3-super-120b-a12b unless these are set.
# The key is never committed.
CARELOOP_LLM_API_KEY=
CARELOOP_LLM_BASE_URL=
CARELOOP_LLM_MODEL=

# Msingi Sauti. Speaks and transcribes the voice simulator. Does not place a phone call.
# The key is never committed.
MSINGI_API_KEY=
MSINGI_BASE_URL=https://api.msingiai.com
MSINGI_VOICE=female
