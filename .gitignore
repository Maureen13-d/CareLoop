# Secrets and local settings
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Local databases (all demo data is regenerated by the seed script)
*.db
*.sqlite
*.sqlite3
backend/careloop.db

# Node / Next.js
node_modules/
.next/
out/
npm-debug.log*

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Model weights and large local artifacts (link to them instead of committing)
*.pt
*.pth
*.onnx
*.gguf
*.db-journal

# Open KSL pose dataset. Download with scripts/fetch_ksl_dataset.py. Never commit.
data/external/
*.npy
*.npz

# Raw KSL capture. Never commit video, mocap, or signer photos.
# Rendered packs belong under assets/ksl/approved/ as Git LFS pointers.
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wmv
*.m4v
*.mpg
*.mpeg
*.3gp
*.bvh
*.c3d
*.fbx
*.trc
*.heic
*.heif
capture/
raw_mocap/
signer_photos/
signer_footage/
!assets/ksl/approved/**/*.mp4
!assets/ksl/approved/**/*.webm
