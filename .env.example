# Backend (prefix CARELOOP_)
CARELOOP_SEED_CASES=25
CARELOOP_SEED=42
# Frontend: copy this file to frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000

# Override the database location (default: backend/careloop.db)
# CARELOOP_DATABASE_URL=sqlite:///./careloop.db

# Telegram adapter. Placeholders only. Never put a real token in git.
# The bot reads the first name in each pair, then the CARELOOP_ alias.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
TELEGRAM_BOT_USERNAME=replace-me
PUBLIC_BASE_URL=http://localhost:8000
CARELOOP_TELEGRAM_BOT_TOKEN=replace-me
CARELOOP_TELEGRAM_WEBHOOK_SECRET=replace-me

# Prototype only. Shows the simulated one-time code on a staff screen.
# Set to false before any real deployment.
CARELOOP_EXPOSE_SIMULATED_CODES=true
