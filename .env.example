# Copy to backend/.env for local settings. NEVER commit a real .env file.
# All values below are demo placeholders.

# SECRET_KEY signs login tokens. Change it for anything beyond local demos.
SECRET_KEY=change-me-for-anything-beyond-a-local-demo
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Default database is a SQLite file at backend/careloop.db (git-ignored).
# To use another database later, set DATABASE_URL, for example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost/careloop

# Deadline checker running automatically in the background (demo can also trigger it by hand)
ENABLE_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=60

# A positive screening opens a tracked case only if the patient has a care_coordination consent
REQUIRE_CONSENT_FOR_TRACKING=true

CORS_ORIGINS=http://localhost:3000

# Password given to the synthetic demo accounts created by the seed script
DEMO_PASSWORD=careloop-demo
